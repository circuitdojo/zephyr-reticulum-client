config RET_CORE
	bool "Reticulum protocol core"
	# PSA Crypto provider: Zephyr's mbedTLS, unless TF-M or nrf_security
	# provide the API. (NCS also has PSA_CRYPTO, vanilla 4.2 does not;
	# MBEDTLS_PSA_CRYPTO_C exists in both.)
	select MBEDTLS if !BUILD_WITH_TFM && !NRF_SECURITY
	select MBEDTLS_PSA_CRYPTO_C if !BUILD_WITH_TFM && !NRF_SECURITY
	imply PSA_WANT_ALG_SHA_256
	imply PSA_WANT_ALG_HMAC
	imply PSA_WANT_KEY_TYPE_HMAC
	imply PSA_WANT_KEY_TYPE_AES
	imply PSA_WANT_ALG_CBC_NO_PADDING
	select ENTROPY_GENERATOR
	help
	  Reticulum wire protocol without networking: HDLC framing, packet
	  codec, identity/destination hashing, announce validation,
	  encryption to SINGLE destinations and proof validation. Curve
	  operations come from Monocypher; hashing, HMAC and AES come from
	  the PSA Crypto API. Selected by RET_CLIENT; unit tests enable it
	  on its own.

menuconfig RET_CLIENT
	bool "Reticulum client"
	select RET_CORE
	select NET_SOCKETS
	select EVENTFD
	# The client identity (its address) and announce clock persist here;
	# the application picks the backend (e.g. SETTINGS_NVS).
	select SETTINGS
	help
	  Reticulum client that connects to an rnsd TCPServerInterface,
	  learns destinations from announces, sends encrypted DATA packets
	  and validates delivery proofs.

if RET_CORE

config RET_MAX_KNOWN_DESTINATIONS
	int "Known destinations table size"
	default 8
	help
	  Destinations learned from validated announces. The least
	  recently seen entry is evicted when the table is full.

config RET_MAX_PENDING_RECEIPTS
	int "Pending delivery receipts"
	default 8

config RET_RECEIPT_TIMEOUT_MS
	int "Delivery proof timeout (ms)"
	default 30000

config RET_RESOURCE_MAX_SIZE
	int "Largest resource accepted (bytes of encrypted stream)"
	default 8192
	range 1024 1048576
	help
	  Responses larger than one link packet arrive as RNS Resources and
	  are assembled in RAM: the client holds a stream buffer and a
	  plaintext buffer of this size. Larger resources are refused.

module = RET
module-str = Reticulum
source "subsys/logging/Kconfig.template.log_config"

endif # RET_CORE

if RET_CLIENT

configdefault ZVFS_EVENTFD_MAX
	int
	default 3

config RET_SERVER_HOST
	string "rnsd host"
	default "127.0.0.1"
	help
	  Host (IP literal or hostname) of the rnsd TCPServerInterface.

config RET_SERVER_PORT
	int "rnsd TCP port"
	default 4242

config RET_THREAD_STACK_SIZE
	int "Client thread stack size"
	default 6144

config RET_THREAD_PRIORITY
	int "Client thread priority"
	default 7

config RET_TX_QUEUE_DEPTH
	int "Outbound send queue depth"
	default 4

config RET_MAX_HELD_SENDS
	int "Sends held while a path is requested"
	default 4
	help
	  A send to a destination with no current path (never announced
	  to us, or learned on a previous connection) is held while a path
	  request goes out, and released by the announce or path response.

config RET_PATH_REQUEST_INTERVAL_MS
	int "Path request retry interval (ms)"
	default 15000
	help
	  While a send is held, its path request is repeated this often.
	  rnsd batches repeat requests for the same destination for 45 s
	  (Transport.PATH_REQUEST_GATE_TIMEOUT) unless one was answered, so
	  faster retries only add traffic.

config RET_PATH_REQUEST_TIMEOUT_MS
	int "Path request timeout (ms)"
	default 60000
	help
	  A held send fails with RET_RECEIPT_FAILED if no path arrives in
	  this time. Keep it above rnsd's 45 s path request gate plus one
	  retry interval, or a request made soon after an earlier one for
	  the same destination can never be answered in time.

config RET_CONNECT_TIMEOUT_MS
	int "TCP connect timeout per address (ms)"
	default 30000
	help
	  The connect runs non-blocking, so the client keeps answering
	  queued sends and expiring held ones while it waits.

config RET_SEND_TIMEOUT_MS
	int "Socket send timeout (ms)"
	default 10000
	help
	  SO_SNDTIMEO on the TCP socket, so a stalled connection cannot
	  block the client thread indefinitely. A send that times out
	  drops the connection.

config RET_TCP_KEEPALIVE
	bool "TCP keepalive"
	default y
	depends on NET_NATIVE_OFFLOADED_SOCKETS || NET_TCP_KEEPALIVE
	help
	  Enable TCP keepalive probes so a connection silently dropped by a
	  NAT is detected. Only offered where the socket layer implements
	  them (host sockets on native_sim, Zephyr's TCP stack with
	  NET_TCP_KEEPALIVE). The nRF91 modem does not; there the receipt
	  watchdog below detects a dead connection.

if RET_TCP_KEEPALIVE

config RET_TCP_KEEPALIVE_IDLE_S
	int "Idle time before the first probe (s)"
	default 60

config RET_TCP_KEEPALIVE_INTERVAL_S
	int "Interval between probes (s)"
	default 10

config RET_TCP_KEEPALIVE_COUNT
	int "Unanswered probes before the connection is dropped"
	default 3

endif # RET_TCP_KEEPALIVE

config RET_RECONNECT_AFTER_TIMEOUTS
	int "Reconnect after this many consecutive receipt timeouts"
	default 3
	help
	  Consecutive sends that time out without a proof suggest the
	  connection is dead even though the socket looks open. Only sends
	  to destinations that have proved before count: RNS destinations
	  do not prove by default, and their silence says nothing about the
	  link. A delivered proof resets the count. 0 disables.

config RET_RX_SILENCE_TIMEOUT_S
	int "Reconnect after this long without receiving anything (s)"
	default 0
	help
	  Off by default: a quiet network may legitimately send nothing for
	  a long time. Useful where the upstream is known to announce
	  regularly. 0 disables.

config RET_ANNOUNCE_INTERVAL_S
	int "Re-announce the client's destination every N seconds"
	default 0
	help
	  The client's own destination (when the application registers
	  one) is announced on every connect and on ret_client_announce().
	  A non-zero value also re-announces it periodically. Each announce
	  persists the announce clock, so keep this modest on flash.

config RET_ANNOUNCE_CLOCK_BLOCK
	int "Announce clock values reserved per flash write"
	default 64
	range 1 65536
	help
	  Each announce needs an emission time newer than any used before,
	  across reboots. The client persists a reservation and uses values
	  from it in RAM, writing flash once per this many announces. A
	  reboot skips the rest of the block, which costs nothing (the
	  clock has 40 bits).

config RET_PATH_RESPONSE_INTERVAL_MS
	int "Minimum time between path responses for our destination (ms)"
	default 5000
	help
	  Answering a path request means signing and sending an announce.
	  Requests arriving faster than this, or repeating a recent tag, are
	  ignored, so the network cannot make the client announce at will.

config RET_RECENT_PACKETS
	int "Recently received packets remembered for duplicate filtering"
	default 8
	help
	  A DATA packet whose hash was seen recently is dropped instead of
	  being delivered and proved again.

config RET_LINK_MAX_REQUESTS
	int "Requests outstanding on the link at once"
	default 2

config RET_RECONNECT_BACKOFF_MAX_S
	int "Maximum reconnect backoff (s)"
	default 60
	help
	  Reconnect delay doubles from 1 s after each failed attempt, up
	  to this limit.

endif # RET_CLIENT
