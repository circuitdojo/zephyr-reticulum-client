menu "ret_basic sample"

config RET_SAMPLE_DEST_NAME
	string "Destination name to send to"
	default "retclient.echo"
	help
	  Full "app.aspect..." name. The sample sends to the first
	  announced destination whose name hash matches.

config RET_SAMPLE_DEST_HASH
	string "Destination hash to send to (32 hex digits)"
	default ""
	help
	  When set, the sample sends to this destination straight away
	  instead of waiting for an announce matching RET_SAMPLE_DEST_NAME;
	  the client requests a path to it on demand.

config RET_SAMPLE_SEND_INTERVAL_S
	int "Seconds between messages"
	default 10

config RET_SAMPLE_MESSAGE_COUNT
	int "Messages to send (0 = forever)"
	default 0
	help
	  After this many messages resolve, the sample logs a summary and,
	  on native_sim, exits with status 0 if every message was
	  delivered and 1 otherwise.

endmenu

source "Kconfig.zephyr"
