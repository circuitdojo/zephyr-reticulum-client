menu "ret_basic sample"

config RET_SAMPLE_DEST_NAME
	string "Destination name to send to"
	default "retclient.echo"
	help
	  Full "app.aspect..." name. The sample sends to the first
	  announced destination whose name hash matches.

config RET_SAMPLE_DEST_HASH
	string "Destination hash to send to (32 hex digits)"
	default ""
	help
	  When set, the sample sends to this destination straight away
	  instead of waiting for an announce matching RET_SAMPLE_DEST_NAME;
	  the client requests a path to it on demand.

config RET_SAMPLE_LOCAL_NAME
	string "The sample's own destination name"
	default "retclient.node"
	help
	  The sample announces this destination, logs what is sent to it,
	  and proves it. Its address comes from an identity created on
	  first start and kept in settings. Empty makes the sample
	  send-only.

config RET_SAMPLE_EXPECT_REPLIES
	bool "Require a reply to every message"
	help
	  For the end-to-end test against tools/rns_peer/peer.py --reply:
	  success also requires an "echo: ..." packet for every message
	  sent, waiting up to RET_SAMPLE_REPLY_WAIT_S for late ones.

config RET_SAMPLE_REPLY_WAIT_S
	int "Seconds to wait for outstanding replies"
	default 10
	depends on RET_SAMPLE_EXPECT_REPLIES

config RET_SAMPLE_SEND_INTERVAL_S
	int "Seconds between messages"
	default 10

config RET_SAMPLE_MESSAGE_COUNT
	int "Messages to send (0 = forever)"
	default 0
	help
	  After this many messages resolve, the sample logs a summary and,
	  on native_sim, exits with status 0 if every message was
	  delivered and 1 otherwise.

endmenu

source "Kconfig.zephyr"
