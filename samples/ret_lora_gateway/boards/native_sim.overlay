/*
 * LittleFS at /lfs, as on the Feather's external NOR: the upper half of
 * the simulated flash (a file, --flash=<path>), above the board's
 * partitions.
 */

/ {
	fstab {
		compatible = "zephyr,fstab";
		lfs: lfs {
			compatible = "zephyr,fstab,littlefs";
			mount-point = "/lfs";
			partition = <&lfs_partition>;
			automount;
			read-size = <16>;
			prog-size = <16>;
			cache-size = <64>;
			lookahead-size = <32>;
			block-cycles = <512>;
		};
	};
};

&flash0 {
	partitions {
		lfs_partition: partition@100000 {
			label = "lfs";
			reg = <0x00100000 0x00100000>;
		};
	};
};
