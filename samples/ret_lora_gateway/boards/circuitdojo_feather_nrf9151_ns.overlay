/*
 * The gateway on the nRF9151 Feather.
 *
 * - Internal flash: TF-M and the app (samples/common), no bootloader.
 * - External NOR: ZMS settings and paths, each on a partition of their own,
 *   instead of the board's 16 MB LittleFS. Flashing this replaces whatever
 *   LittleFS held there (other samples' settings).
 * - SX1262: a Seeed Wio-SX1262 for XIAO (the version with the 30-pin
 *   board-to-board connector), wired as in ../docs/wio-sx1262-hookup.md.
 *   SPI on the Feather header (SCK P0.20, COPI P0.21, CIPO P0.22) through
 *   spi1 (uart1's instance, unused); the NOR keeps spi3. Control pins:
 *   NSS D2 (P0.26), NRESET D3 (P0.27), BUSY D4 (P0.28), DIO1 D5 (P0.29),
 *   RF_SW D6 (P0.30). The module's RF switch has two controls: DIO2 for
 *   TX, RF_SW (high in RX, low otherwise) for RX. Driving RF_SW alongside
 *   DIO2 needs zephyr/patches.yml (the native driver otherwise ignores
 *   rx-enable-gpios when dio2-tx-enable is set). TCXO 1.8 V from DIO3.
 */

#include <zephyr/dt-bindings/lora/sx126x.h>

#include "../../common/circuitdojo_feather_nrf9151_ns_flash.dtsi"

/delete-node/ &lfs;
/delete-node/ &lfs_partition;

/ {
	chosen {
		zephyr,settings-partition = &gw_settings_partition;
	};
};

&w25q128jv {
	partitions {
		gw_settings_partition: partition@0 {
			label = "gw-settings";
			reg = <0x00000000 0x00010000>;
		};

		gw_paths_partition: partition@10000 {
			label = "gw-paths";
			reg = <0x00010000 0x00800000>;
		};
	};
};

&pinctrl {
	spi1_default: spi1_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 20)>,
				<NRF_PSEL(SPIM_MOSI, 0, 21)>,
				<NRF_PSEL(SPIM_MISO, 0, 22)>;
		};
	};

	spi1_sleep: spi1_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 20)>,
				<NRF_PSEL(SPIM_MOSI, 0, 21)>,
				<NRF_PSEL(SPIM_MISO, 0, 22)>;
			low-power-enable;
		};
	};
};

&uart1 {
	status = "disabled";
};

&spi1 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	cs-gpios = <&gpio0 26 GPIO_ACTIVE_LOW>;
	pinctrl-0 = <&spi1_default>;
	pinctrl-1 = <&spi1_sleep>;
	pinctrl-names = "default", "sleep";

	lora0: lora@0 {
		compatible = "semtech,sx1262";
		reg = <0>;
		spi-max-frequency = <8000000>;
		reset-gpios = <&gpio0 27 GPIO_ACTIVE_LOW>;
		busy-gpios = <&gpio0 28 GPIO_ACTIVE_HIGH>;
		dio1-gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>;
		rx-enable-gpios = <&gpio0 30 GPIO_ACTIVE_HIGH>;
		dio2-tx-enable;
		dio3-tcxo-voltage = <SX126X_DIO3_TCXO_1V8>;
		tcxo-power-startup-delay-ms = <5>;
	};
};
